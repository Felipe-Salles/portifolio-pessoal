---
// Source: Arquivos de design/code.html lines 1-13 (head) and 220-224 (body wrapper),
// adapted per 01-PATTERNS.md "src/layouts/Base.astro" section.
//
// Mandatory deviations from the prototype (SEC-01 / PROJECT.md PT-BR constraint):
// - lang="pt-BR" (prototype used lang="en")
// - No cdn.tailwindcss.com <script>, no Google Fonts <link>s, no Material Symbols
//   icon-font <link>s, no <link rel="preconnect"> — every one of these is an
//   external network origin and is dropped entirely, not just left unlinked.
import "../styles/global.css";

// Self-hosted font weights (D-01) — per-weight imports only. A bare
// package-root import (no /{weight}.css suffix) silently loads weight 400
// only (RESEARCH.md Pitfall 5), so every weight DESIGN.md requires is
// imported explicitly. Weights confirmed from code.html line 11's Google
// Fonts query string.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/lexend/400.css";
import "@fontsource/lexend/500.css";
import "@fontsource/lexend/600.css";
import "@fontsource/lexend/700.css";
import "@fontsource/lexend/800.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.ts";

// Source: 04-RESEARCH.md Architecture Patterns Pattern 1 (SEO-01/SEO-02) —
// description is required (every page passes one explicitly, no default);
// ogImage/ogType default to the one shared OG image (D-03).
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  ogType = "website",
} = Astro.props;

// Absolute URLs are mandatory for canonical/OG/Twitter tags (Open Graph
// unfurlers ignore relative image/url values) — never a bare string.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.brand} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-background text-on-background bg-grid-pattern relative min-h-screen">
    <a href="#main-content" class="skip-link fixed top-4 left-4 z-[100] glass-panel border-glow-cyan px-4 py-2 rounded font-mono-label text-mono-label text-primary-container uppercase tracking-widest"
      >Pular para o conteúdo</a
    >
    <div class="glow-cloud-top-right" aria-hidden="true"></div>
    <div class="glow-cloud-bottom-left" aria-hidden="true"></div>
    <Nav />
    <main id="main-content" class="relative z-10 pt-32 pb-section-gap px-margin-mobile md:px-gutter max-w-container-max mx-auto space-y-section-gap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
