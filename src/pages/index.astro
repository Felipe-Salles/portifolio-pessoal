---
// Source: Arquivos de design/code.html lines 248-292 (Hero 248-263, Dossier
// 265-292) and lines 294-325 (Tech Stack). Replaces Phase 1's
// pipeline-proof scaffolding — Phase 3's real content sections begin here.
//
// Mandatory deviations from the prototype:
// - CTA copy is PT-BR ("VER PROJETOS"), never the prototype's literal
//   "VIEW PROJECTS" (CLAUDE.md's PT-BR constraint applies to new copy).
// - Every rendered string comes from src/data/site.ts, never a hardcoded
//   persona literal.
// - The prototype's radius-suffix class (not a real Tailwind class name)
//   corrected to bare `rounded` throughout.
// - The prototype's smaller monospace token is consolidated up to the
//   mono-label token throughout (typography size-budget consolidation).
// - Hero paragraph/Dossier bio use the body-md token (not the prototype's
//   larger one) plus a font-medium weight override (typography
//   consolidation).
// - Hero H1 uses a semibold weight override (not the prototype's bold)
//   per the heading-group weight consolidation.
// - The visitor-name field is deliberately never rendered anywhere on this
//   page (D-03) — it stays reserved for future meta tags.
// - Tech Stack renders a fixed three-entry category list built from
//   site.techStack's three named keys (TECH-01), never a generic loop over
//   arbitrary category names.
// - Contact (code.html lines 379-396): copy comes from the two new
//   contactHeading/contactSubtitle site.ts fields instead of the
//   prototype's persona text; every icon-only anchor gains an aria-label
//   (the prototype has none); rel="noopener noreferrer" is applied
//   unconditionally, even though every href is still the inert placeholder
//   "#" (D-13).
import Base from "../layouts/Base.astro";
import { site } from "../data/site.ts";
import { Icon } from "astro-icon/components";

// Fixed three-category list (TECH-01) — enumerated explicitly rather than
// derived from a generic iteration over the techStack object's own keys,
// since the design requires exactly these three named categories in this
// order. The explicit `items: readonly string[]` annotation widens each
// entry beyond its narrow `as const` tuple-literal inference so the `.map`
// calls below type-check even though the three arrays hold different-length
// literal tuples.
const techCategories: { label: string; items: readonly string[] }[] = [
  { label: "LANGUAGES", items: site.techStack.languages },
  { label: "FRAMEWORKS", items: site.techStack.frameworks },
  { label: "INFRASTRUCTURE", items: site.techStack.infrastructure },
];
---

<Base title="Portfólio Dev — Felipe Salles">
  <section class="min-h-[716px] flex flex-col justify-center items-start">
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-8 border border-outline-variant/50 bg-surface-container/50 rounded font-mono-label text-mono-label text-primary-container">
      <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
      &gt;_ {site.availabilityStatus}
    </div>
    <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg font-semibold tracking-tight text-white mb-4 uppercase">
      {site.heroHeading}
    </h1>
    <p class="font-mono-label text-mono-label text-primary-container uppercase tracking-widest mb-6">
      {site.title}
    </p>
    <p class="font-body-md text-body-md font-medium text-on-surface-variant max-w-2xl mb-12">
      {site.heroSubtitle}
    </p>
    <a
      href="#projects"
      class="btn-primary bg-primary-container text-on-primary-container font-mono-label text-mono-label uppercase tracking-widest px-8 py-4 rounded transition-all duration-300 cursor-pointer active:scale-95 inline-flex items-center gap-2"
    >
      VER PROJETOS
      <Icon name="material-symbols:arrow-forward" class="text-xl" />
    </a>
  </section>

  <section class="scroll-mt-32" id="dossier">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-8 space-y-8 glass-panel p-8 rounded-lg">
        <h2 class="font-headline-md text-headline-md text-white border-b border-outline-variant/30 pb-4 inline-block">DOSSIER</h2>
        <div class="font-body-md text-body-md font-medium text-on-surface-variant space-y-6">
          {site.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
      <div class="md:col-span-4 glass-panel p-6 rounded-lg border-glow-cyan h-full">
        <h3 class="font-mono-label text-mono-label text-primary-container uppercase tracking-widest mb-6 pb-2 border-b border-primary-container/30">SYSTEM SPECS</h3>
        <ul class="space-y-4 font-mono-label text-mono-label text-on-surface-variant">
          {site.systemSpecs.map((spec) => (
            <li class="flex justify-between items-center">
              <span class="text-white">{spec.label}</span>
              <span>{spec.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="scroll-mt-32" id="stack">
    <h2 class="font-headline-md text-headline-md text-white border-b border-outline-variant/30 pb-4 mb-12 inline-block">TECH STACK</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {techCategories.map((category) => (
        <div class="glass-panel p-6 rounded-lg">
          <h3 class="font-mono-label text-mono-label text-secondary uppercase tracking-widest mb-6">{category.label}</h3>
          <div class="flex flex-wrap gap-3">
            {category.items.map((tech) => (
              <span class="px-3 py-1 bg-surface-container border border-outline-variant/50 text-white font-mono-label text-mono-label rounded">[ {tech.toUpperCase()} ]</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="scroll-mt-32 glass-panel p-12 rounded-xl text-center border-glow-cyan max-w-3xl mx-auto">
    <h2 class="font-headline-md text-headline-md text-white mb-4">{site.contactHeading}</h2>
    <p class="font-body-md text-body-md font-medium text-on-surface-variant mb-8 max-w-lg mx-auto">{site.contactSubtitle}</p>
    <div class="flex justify-center gap-6">
      {site.socials.map((s) => (
        <a
          href={s.href}
          rel="noopener noreferrer"
          aria-label={s.label}
          class="w-12 h-12 rounded-full border border-outline-variant/50 flex items-center justify-center text-on-surface-variant hover:text-primary-container hover:border-primary-container hover:shadow-[0_0_10px_rgba(0,240,255,0.3)] transition-all duration-300"
        >
          <Icon name={s.icon} />
        </a>
      ))}
    </div>
  </section>
</Base>
