---
// Scaffolding — pipeline proof + token gallery only. Replaced by the real
// page shell in Phase 2 (nav/layout) and Phase 3 (content sections).
//
// The gallery below is not a design comp — it exists purely so Tailwind v4
// emits utility class *rules* (not just @theme custom properties) for a
// representative class per token family, so the build-output assertions in
// 01-02-PLAN.md Task 1/2 have something real to check against.
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
---

<Base title="PIPELINE OK — Portfólio Dev">
  <main>
    <h1>PIPELINE OK</h1>

    <!-- Icon self-hosting proof: all 7 required Material Symbols glyphs,
         base names only — none of them has a "-outline" variant needed here
         (RESEARCH.md Pattern 4 / Assumptions Log A1). -->
    <p>
      <Icon name="material-symbols:menu" />
      <Icon name="material-symbols:arrow-forward" />
      <Icon name="material-symbols:open-in-new" />
      <Icon name="material-symbols:code" />
      <Icon name="material-symbols:work" />
      <Icon name="material-symbols:mail" />
      <Icon name="material-symbols:chat" />
    </p>

    <!-- Font self-hosting proof: forces the built CSS to include @font-face
         rules for all three self-hosted families. -->
    <p style="font-family: Lexend, sans-serif;">Lexend sample text</p>
    <p style="font-family: Inter, sans-serif;">Inter sample text</p>
    <p style="font-family: 'JetBrains Mono', monospace;">JetBrains Mono sample text</p>

    <!-- Token gallery — one representative utility per @theme token family. -->
    <div class="bg-surface-container border border-outline-variant px-margin-mobile gap-gutter max-w-container-max rounded">
      <span class="text-on-surface-variant">on-surface-variant sample</span>
      <p class="text-display-lg">Display LG</p>
      <p class="text-headline-md">Headline MD</p>
      <p class="text-body-md">Body MD</p>
      <p class="text-mono-label font-mono-label">MONO LABEL</p>
      <div class="rounded-lg">rounded-lg box</div>
      <div class="rounded-full">rounded-full box</div>
    </div>
  </main>
</Base>
