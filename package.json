{
  "name": "portifolio-pessoal",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-og-image.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "verify:sec01": "node scripts/verify-no-external-origins.mjs",
    "verify:tokens": "node scripts/verify-design-tokens.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:sections": "node scripts/verify-sections.mjs",
    "verify:schema": "node scripts/verify-content-schema.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:deploy": "node scripts/verify-deploy-headers.mjs",
    "verify:csp-hash": "node scripts/verify-csp-hash.mjs",
    "verify:secrets": "node scripts/verify-no-client-secrets.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "verify:live-csp": "node scripts/verify-live-csp.mjs",
    "verify": "npm run build && npm run verify:sec01 && npm run verify:tokens && npm run verify:shell && npm run verify:sections && npm run verify:schema && npm run verify:seo && npm run verify:a11y && npm run verify:csp-hash && npm run verify:secrets"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@iconify-json/material-symbols": "^1.2.90",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wcag-contrast": "^3.0.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
